# Resend (https://resend.com) — usado por app/api/contact para enviar el
# formulario de contacto a info@devnova.com.ar sin sacar al visitante del sitio.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Remitente con dominio verificado en Resend (opcional hasta verificar el dominio).
# Ej: RESEND_FROM=DevNova web <web@devnova.com.ar>
RESEND_FROM=
